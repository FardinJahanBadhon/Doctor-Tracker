# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker

# CORS — must match the frontend's origin
CLIENT_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
COOKIE_NAME=dt_token

# Used only by `npm run create-admin` (optional — can pass --name/--email/--password instead)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@doctortracker.com
ADMIN_PASSWORD=change-this-password
